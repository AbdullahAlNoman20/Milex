// FILE: server/tsconfig.json
//  esModuleInterop fix, still the current standard fix for this TS7 error class in 2026

{
  "compilerOptions": {
    "target": "ES2022",
    // Kept on the classic resolver: every dependency here is consumed as
    // CommonJS, and node16 resolution rejects the ESM-only ones outright.
    // The deprecation is acknowledged explicitly rather than worked around.
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "moduleResolution": "node",

    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}